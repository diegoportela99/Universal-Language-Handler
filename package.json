{
	"name": "universal-language-handler",
	"displayName": "Universal Language Handler",
	"description": "Translate code comments and identifiers to any language using AI",
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:universal-language-handler.translateFile",
		"onCommand:universal-language-handler.translateSelection",
		"onCommand:universal-language-handler.setLanguage"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "universal-language-handler.translateFile",
				"title": "Universal Language Handler: Translate File"
			},
			{
				"command": "universal-language-handler.translateSelection",
				"title": "Universal Language Handler: Translate Selection"
			},
			{
				"command": "universal-language-handler.setLanguage",
				"title": "Universal Language Handler: Set Target Language"
			}
		],
		"configuration": {
			"title": "Universal Language Handler",
			"properties": {
				"universalLanguageHandler.targetLanguage": {
					"type": "string",
					"default": "Spanish",
					"description": "Target language for code translation"
				},
				"universalLanguageHandler.anthropicApiKey": {
					"type": "string",
					"default": "",
					"markdownDescription": "Anthropic API key. Can also be set via the `ANTHROPIC_API_KEY` environment variable."
				},
				"universalLanguageHandler.translateComments": {
					"type": "boolean",
					"default": true,
					"description": "Translate code comments"
				},
				"universalLanguageHandler.translateIdentifiers": {
					"type": "boolean",
					"default": true,
					"description": "Translate function and variable names"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "NODE_OPTIONS=--openssl-legacy-provider webpack",
		"watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --watch",
		"package": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode production --devtool hidden-source-map",
		"test-compile": "tsc -p ./",
		"test-watch": "tsc -watch -p ./",
		"pretest": "npm run test-compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"test:unit": "npm run test-compile && mocha --ui tdd --timeout 10000 \"out/test/unit/**/*.test.js\""
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.90.0"
	},
	"devDependencies": {
		"@types/glob": "^7.2.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.17.0",
		"@types/vscode": "^1.80.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^8.57.1",
		"glob": "^7.2.3",
		"mocha": "^10.7.3",
		"ts-loader": "^9.5.1",
		"typescript": "^5.7.0",
		"webpack": "^5.99.0",
		"webpack-cli": "^5.1.4"
	}
}
